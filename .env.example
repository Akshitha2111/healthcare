# Copy to .env and fill in. NEVER commit the real file. Spring Boot reads real environment variables:
#   Linux/macOS:  set -a; source .env; set +a
#   PowerShell:   Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }

# ---- MySQL -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
DB_URL=jdbc:mysql://localhost:3306/healthcare_assistant?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=healthcare
DB_PASSWORD=change-me-db

# ---- Spring Boot -------------------------------------------------------
# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false          # true when served over HTTPS
COOKIE_SAME_SITE=Lax         # None (+COOKIE_SECURE=true) only if frontend and API are on different sites
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_API_KEY=          # optional shared key; must equal the Flask value below
AI_TIMEOUT_MS=5000
ADMIN_EMAIL=admin@example.com        # first administrator is created at startup if both are set
ADMIN_PASSWORD=                      # choose a strong password (min 8 chars)
SEED_DEMO_DOCTORS=true               # inserts 3 FICTIONAL doctors when the table is empty
ANALYTICS_MIN_GROUP_SIZE=5           # small groups are hidden from admin analytics (use 1-2 for a tiny demo)
CLINIC_TIMEZONE=Asia/Kolkata

# ---- Flask AI service --------------------------------------------------
# AI_SERVICE_API_KEY (above) is read by Flask too. Set the same value in both processes.
AI_MODEL_DIR=./model
